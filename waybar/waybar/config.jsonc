// Waybar config — colors live in style.css (VS Code Dark+, see palette.md).
// Icons require the JetBrainsMono Nerd Font installed by
// fonts/install-nerd-font.sh.
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 4,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "tray"
    ],

    "niri/workspaces": {
        "format": "{index}"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "format-wifi": "{icon}  {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤮  disconnected",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "$HOME/.config/niri/scripts/wifi-menu.sh"
        // for full network management (VPNs, static IPs, etc.) use:
        // "on-click-right": "alacritty -e nmtui"
    },

    // Requires waybar built with bluez support — if this module produces no
    // output on your build, drop it from modules-right above.
    "bluetooth": {
        "format": "󰂯  {status}",
        "format-connected": "󰂱  {device_alias}",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\nconnected: {device_alias}",
        "on-click": "$HOME/.config/niri/scripts/bluetooth-menu.sh"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "cpu": {
        "format": "󰘚  {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "interval": 5
    },

    // Delete this module if the target machine is a desktop with no battery.
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "tray": {
        "icon-size": 22,
        "spacing": 8
    }
}

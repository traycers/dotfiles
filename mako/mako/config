# mako notification daemon — VS Code Dark+ theme, see palette.md
sort=-time
layer=overlay
anchor=top-right
width=420
height=150
margin=10
padding=14
font=JetBrainsMono Nerd Font 18
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=0

background-color=#252526E6
text-color=#d4d4d4
border-size=2
border-color=#007acc
border-radius=6
progress-color=over #0e639c

[urgency=low]
border-color=#454545
default-timeout=3000

[urgency=normal]
border-color=#007acc

[urgency=critical]
background-color=#5a1d1d
text-color=#f44747
border-color=#f44747
default-timeout=0

// niri config — see palette.md for the VS Code Dark+ hex values used below.
// Full option reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    mouse {
        accel-speed 0.0
    }

    focus-follows-mouse disabled-on-external-events=true
}

// One `output` block per monitor. Connector names are hardware-specific —
// run `niri msg outputs` after first login and replace "eDP-1" below with
// the real connector name(s), then delete this comment.
output "eDP-1" {
    scale 1.0
    mode "1920x1080@60"
    position x=0 y=0
}

layout {
    gaps 12

    center-focused-column "never"

    default-column-width {
        proportion 0.5
    }

    // niri highlights the focused window with a focus-ring rather than a
    // drawn border by default — keep border off, use focus-ring for the
    // VS Code Dark+ accent color instead.
    focus-ring {
        width 2
        active-color "#007acc"
        inactive-color "#454545"
    }

    border {
        off
    }
}

environment {
    DISPLAY null
}

// Companion services — waybar (status bar), mako (notifications), the
// cliphist watchers (without these, cliphist never records anything), and
// the swayidle wrapper script (idle timeout -> screen off -> lock).
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "bash" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch cliphist store"
spawn-at-startup "bash" "-c" "$HOME/.config/swayidle/swayidle.sh"

binds {
    // Apps
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Shift+V { spawn "bash" "-c" "$HOME/.config/niri/scripts/clipboard-picker.sh"; }
    Mod+Shift+W { spawn "bash" "-c" "$HOME/.config/niri/scripts/wifi-menu.sh"; }
    Mod+Shift+B { spawn "bash" "-c" "$HOME/.config/niri/scripts/bluetooth-menu.sh"; }
    Mod+L { spawn "bash" "-c" "$HOME/.config/niri/scripts/lock.sh"; }
    Print { spawn "bash" "-c" "$HOME/.config/niri/scripts/screenshot.sh"; }
    Mod+Print { spawn "bash" "-c" "$HOME/.config/niri/scripts/screenshot.sh --full"; }

    // Window / column management
    Mod+Q { close-window; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+C { center-column; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    // Resize (enter resize mode, arrows adjust, Return/Escape exit)
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Session
    Mod+Shift+E { quit; }
    Mod+Shift+Q { spawn "bash" "-c" "$HOME/.config/niri/scripts/lock.sh"; }
}

// Window rules go here once you know what actually needs them after first
// run (e.g. floating a launcher) — don't speculatively add any.
